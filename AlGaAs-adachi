# 传入波长单位nm，组分参数，计算折射率
def n(l,x):
    Egl=1239.84/l #l单位nm
    # #根据组分计算Eg，判断是否吸收光
    # if x<0 or x> 1:
    #      print("Aluminium fraction range 0 =< x =< 1")           
    # elif x>=0.45:
    #     Eg=1.9+0.125*x+0.143*x*x
    # else :
    #     Eg=1.422+1.2475*x
    #     if Egl>=Eg:
    #         print("Material is absorbing!")
    E0=1.425 + 1.155*x + 0.37*x*x
    k=Egl/E0 
    E1=1.765+1.115*x+0.37*x*x    
    k0=Egl/E1
    A0=6.3+19.0*x #与组分相关的常数
    B0=9.4-10.2*x #与组分相关的常数
    f=(2-m.sqrt(1+k)-m.sqrt(1-k))/(k*k)
    f0=(2-m.sqrt(1+k0)-m.sqrt(1-k0))/(k0*k0)
    b=m.sqrt(m.pow((E0/E1),3))
    p=m.sqrt(A0*(f+f0*0.5*b)+B0)
    return(round(p,4))
